{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/user/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/company/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/job/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/application/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
