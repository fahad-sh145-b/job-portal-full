{
  "name": "job-portal-full",
  "version": "1.0.0",
  "description": "Job Portal Full Stack Application",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "cd backend && npm install && cd ../frontend && npm install && cd ../notification-service && npm install",
    "build": "cd frontend && npm run build",
    "start": "concurrently --names \"BACKEND,NOTIF\" -c \"cyan,magenta\" \"npm run start:backend\" \"npm run start:notifications\"",
    "dev": "concurrently --names \"BACKEND,NOTIF\" -c \"cyan,magenta\" \"npm run start:backend\" \"npm run start:notifications\"",
    "start:backend": "cd backend && node server.js",
    "start:notifications": "cd notification-service && node server.js",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
